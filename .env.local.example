# Copia este archivo a .env.local y completa con los valores de tu proyecto Supabase.
# (Settings → API en el dashboard de Supabase)

# URL del proyecto, p. ej. https://abcdefgh.supabase.co
NEXT_PUBLIC_SUPABASE_URL=

# Clave pública (segura para el navegador; RLS protege los datos).
# Supabase la llama "anon" (formato eyJ...) o, en el nuevo formato,
# "publishable" (formato sb_publishable_...). Cualquiera de las dos sirve aquí.
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Clave secreta — SOLO servidor. Es la "service_role" (eyJ...) o la nueva
# "secret" (sb_secret_...). Necesaria únicamente si automatizas el alta de
# profesores. NUNCA la expongas al cliente ni la subas a git.
SUPABASE_SERVICE_ROLE_KEY=
